# FieldFlow — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Django Core ───────────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────
# SQLite (default for development — no setup needed)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (production — uncomment and fill in)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fieldflow_db

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── JWT ───────────────────────────────────────────────────────
# Token lifetimes — values in minutes/days (set in settings.py)
# JWT_ACCESS_TOKEN_MINUTES=30
# JWT_REFRESH_TOKEN_DAYS=7

# ── Email (optional — for password reset) ────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password
